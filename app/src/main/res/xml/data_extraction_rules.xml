<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+. Same rule for both channels: the diary, the plan and the
  settings may be restored onto a new phone; the API key may not.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
