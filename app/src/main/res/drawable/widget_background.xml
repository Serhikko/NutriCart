<?xml version="1.0" encoding="utf-8"?>
<!-- The widget card before Android 12, which has no system corner radius: a white rounded rectangle
     that the widget tints with the Ember surface colour (white by day, graphite at night). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="16dp" />
</shape>
